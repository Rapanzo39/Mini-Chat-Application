<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>write new chat</title>
</head>
<body>
    <div class="form-page">
    <h3>Write new chat..</h3>
    <form method="post" action="/chats" class="chat-form">
        <input placeholder="who are you" name="from">
        <textarea name="msg">Write your message here...</textarea>
        <input placeholder="who do you want to send" name="to">
        <button type="submit">Send</button>
    </form></div>
</body>
</html>