<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Mini whatsapp</title>
</head>
<body>
    <h3>All chats</h3>
    <form action="/chats/new" class="new-chat-form">
        <button type="submit">New Chat</button>
    
    </form>
   <% for(let chat of chats){ %>
    <div class="chats">
        <p>from :<i> <%= chat.from %></i></p>
        <div class="msg">
            <p><%= chat.msg %></p>
            <form method="get" action="/chats/<%= chat._id %>/edit" class="chat-form">
                <button>Edit</button>
            </form>
            <form method="post" action="/chats/<%= chat._id %>?_method=DELETE" class="chat-form" onsubmit="return confirmDelete()">
                <button>Delete</button>
            </form>
        </div>
        <p> Received by <i><%= chat.to %></i> </p><hr />
         <p><%= chat.createdAt.toString().split(" ").slice(0, 4).join(" ") %></p>
        <p><%= chat.createdAt.toString().split(" ") [4] %></p>
        
    </div>
    </br></br>
<% } %>


<script>
function confirmDelete() {
    return confirm("Are you sure you want to delete this chat?");
}
</script>
</body>
</html>

